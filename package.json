{
  "name": "kube-client-web",
  "version": "0.0.0",
  "description": "Kubernetes client library for the browser with informer support",
  "license": "Apache-2.0",
  "author": "Kazumasa Kohtaka <kkohtaka@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkohtaka/kube-client-web.git"
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "client",
    "browser",
    "informer",
    "watch"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p examples/demo",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:faults": "vitest run --project faults-chromium && vitest run --project faults-firefox && vitest run --project faults-webkit",
    "test:demo": "vitest run --project demo",
    "demo": "vite --config examples/demo/vite.config.ts",
    "demo:build": "vite build --config examples/demo/vite.config.ts",
    "e2e:up": "./e2e/cluster-up.sh",
    "e2e:down": "kind delete cluster --name kube-client-web",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.6",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
